{
  "name": "@nodejs/microtel",
  "private": true,
  "version": "0.0.0",
  "description": "Node.js OpenTelemetry built-in support",
  "license": "MIT",
  "author": "Node.js contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodejs/microtel.git"
  },
  "bugs": {
    "url": "https://github.com/nodejs/microtel/issues"
  },
  "homepage": "https://github.com/nodejs/microtel#readme",
  "keywords": [
    "opentelemetry",
    "tracing",
    "diagnostics_channel"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "scripts": {
    "test": "node --test 'test/test-*.js'",
    "bench": "node --experimental-bench --bench 'benchmark/*.bench.js'",
    "format:check": "prettier --check .",
    "lint": "eslint lib/ test/test-*.js test/common/*.js benchmark/ index.js"
  },
  "devDependencies": {
    "@opentelemetry/semantic-conventions": "1.43.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10"
  }
}
